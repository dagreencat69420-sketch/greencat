# ===== Secrets / key material (NEVER commit) =====
keys/
.keys/
*-keypair.json
*keypair*.json
id.json
**/target/deploy/
*.pem
*.key
*.p12
*.pfx
.secrets/
secrets/

# Environment files: ignore all, keep only examples
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

