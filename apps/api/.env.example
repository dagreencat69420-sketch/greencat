# ─── GreenCat API + indexer (apps/api) ───────────────────────────────────────
# Copy to apps/api/.env (gitignored). Never commit real secrets.

PORT=8787
NODE_ENV=development

# Database
#   unset / pglite:./data/pglite  → embedded PGlite (Postgres-in-WASM, on-disk, zero setup)
#   pglite:memory                → in-memory (tests)
#   postgres://…                 → real Postgres (Docker, Neon, Supabase, Railway…)
# DATABASE_URL=postgres://greencat:greencat@localhost:5432/greencat
DATABASE_URL=pglite:./data/pglite

# Solana RPC used to VERIFY bonus txs and to run the indexer.
#   localnet: http://127.0.0.1:8899 (solana-test-validator with target/deploy/greencat.so)
#   devnet:   https://api.devnet.solana.com  (or Helius devnet URL)
#   mainnet:  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=http://127.0.0.1:8899
# Optional websocket endpoint for INDEXER_MODE=ws (defaults to RPC_URL with ws:// + port+1)
# RPC_WS_URL=ws://127.0.0.1:8900
GREENCAT_PROGRAM_ID=8Sy7mqZjHg9U9JW2qe1fEAfooyUrnDkz1XdqFB3ywvPE

# Sessions (REQUIRED in production: ≥32 random chars, e.g. `openssl rand -hex 32`)
JWT_SECRET=
SESSION_TTL_SEC=3600
NONCE_TTL_SEC=300

# Sign-In-With-Solana message fields (shown in the wallet popup)
SIWS_DOMAIN=localhost:3001
SIWS_URI=http://localhost:8787
# Extra web hosts allowed in the sign-in message; the one matching the request Origin is used.
# SIWS_DOMAINS=greencat-app.vercel.app,app.greencat69420.com
# SIWS Chain ID in the sign-in message (mainnet|devnet|testnet|localnet). Default: derived from SOLANA_NETWORK / RPC_URL.
# SIWS_CHAIN_ID=devnet

# Comma-separated allowed web origins (use your Vercel URL in prod)
CORS_ORIGINS=http://localhost:3001
# TRUST_PROXY (audit API-01/API-03):
#   false (default) → rate limits key on the TCP peer address; X-Forwarded-For / X-Real-IP are IGNORED.
#   true            → key on the FIRST X-Forwarded-For entry (else X-Real-IP).
# Set true ONLY when the API is reachable exclusively through a proxy that overwrites
# X-Forwarded-For (Railway, Fly, Render, Vercel, Cloudflare). If clients can reach the API
# directly while this is true, they can spoof the header and bypass per-IP limits.
TRUST_PROXY=false

# Bonus verification
BONUS_MAX_TX_AGE_SEC=86400
BONUS_COMMITMENT=confirmed
# Per-kind daily bonus caps (audit API-03). Default when unset:
#   {"mint":10,"stake":3,"list":5}     — set '{}' to disable (not recommended)
# BONUS_DAILY_CAPS={"mint":10,"stake":3,"list":5}
# Minimum on-chain amount in WHOLE GC for a tx to earn a bonus (stake amount, list price).
# Default when unset: {"stake":1000,"list":100}  — '{}' disables
# BONUS_MIN_AMOUNTS={"stake":1000,"list":100}
GC_DECIMALS=6

# Indexer
RUN_INDEXER=false          # true = run the indexer loop inside the API process
INDEXER_MODE=poll          # poll | ws (logsSubscribe; Helius-compatible)
POLL_MS=5000               # poll mode interval. On Helius FREE use ≥60000 (getSignaturesForAddress = 10 credits)
INDEXER_SAFETY_POLL_MS=300000  # ws mode: safety-net poll
INDEXER_PAGE_SIZE=100
INDEXER_BACKFILL_MAX=5000

# Optional Helius raw webhook → POST /webhooks/helius with this value as Authorization header
# HELIUS_WEBHOOK_SECRET=

