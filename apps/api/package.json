{
  "name": "@greencat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GreenCat global backend: server-authoritative Points API + marketplace indexer (Hono + Postgres/PGlite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx test/e2e-localnet.ts",
    "test:e2e:market": "tsx test/e2e-market-localnet.ts",
    "test:security": "tsx test/security-negative-localnet.ts",
    "test:scripts": "tsx test/scripts-localnet.ts",
    "test:airdrop-pool": "tsx test/airdrop-pool-localnet.ts",
    "test:vrf-expiry": "tsx test/vrf-expiry-localnet.ts",
    "test:staking-switch": "tsx test/staking-switch-upgrade-localnet.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^1.13.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "bs58": "^4.0.1",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@greencat/sdk": "*",
    "@solana/wallet-standard-util": "^1.1.4",
    "@types/bs58": "^4.0.4",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
