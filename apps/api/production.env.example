# ─── GreenCat API + indexer: PRODUCTION env template (Devnet-first) ─────────────
# Placeholders only. Paste real values into the HOST's secret/variable UI
# (Railway Variables, Render Environment, `fly secrets set`). Never commit real values.
# Full checklist + explanations: docs/HOSTING-RUNBOOK.md §5.

# --- required ---
NODE_ENV=production
# Host usually injects PORT; the image defaults to 8787.
# PORT=8787
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require        # Neon "pooled" connection string
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32                                # ≥32 chars: `openssl rand -hex 32`
RPC_URL=https://devnet.helius-rpc.com/?api-key=CHANGE_ME                # cluster MUST match where the program is deployed
GREENCAT_PROGRAM_ID=8Sy7mqZjHg9U9JW2qe1fEAfooyUrnDkz1XdqFB3ywvPE
CORS_ORIGINS=https://CHANGE_ME.vercel.app                               # comma-separated, exact origins, no trailing slash
SIWS_DOMAIN=CHANGE_ME.vercel.app                                        # host of the web app (shown in wallet popup)
SIWS_DOMAINS=                                                            # optional: more web hosts, comma-separated (popup names the one the user is on)
# SIWS Chain ID in the sign-in message (mainnet|devnet|testnet|localnet). Default: derived from SOLANA_NETWORK / RPC_URL.
# SIWS_CHAIN_ID=devnet
SIWS_URI=https://CHANGE_ME-api.up.railway.app                           # public URL of this API
TRUST_PROXY=1                                                           # only behind Railway/Render/Fly proxy (they overwrite X-Forwarded-For)

# --- indexer ---
RUN_INDEXER=true            # true = index inside the API process. Set false if you run a separate worker service.
INDEXER_MODE=poll           # poll | ws
POLL_MS=60000               # ≥60000 on Helius Free (credit budget)
INDEXER_SAFETY_POLL_MS=300000
# RPC_WS_URL=wss://devnet.helius-rpc.com/?api-key=CHANGE_ME             # only for INDEXER_MODE=ws

# --- Helius webhook (optional, recommended on free/sleeping hosts) ---
HELIUS_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_24                     # paste the SAME value into Helius "Auth Header"

# --- anti-farming (audit API-03); these are the defaults, shown explicitly ---
BONUS_DAILY_CAPS={"mint":10,"stake":3,"list":5}
BONUS_MIN_AMOUNTS={"stake":1000,"list":100}
# Marketplace points (src/points/market.ts). "list" in BONUS_DAILY_CAPS is no longer used.
# Listing: +LIST_POINTS once the listing stayed active LIST_POINTS_MIN_ACTIVE_SEC; once per NFT per
# LIST_POINTS_NFT_WINDOW_SEC; at most LIST_POINTS_MAX_NFTS_PER_DAY distinct NFTs per wallet per 24h.
LIST_POINTS=10
LIST_POINTS_MIN_ACTIVE_SEC=600
LIST_POINTS_NFT_WINDOW_SEC=86400
LIST_POINTS_MAX_NFTS_PER_DAY=5
# Sales (indexer-driven): seller/buyer points; no points for self-trades, same pair + same NFT within
# the pair cooldown, or an NFT that already earned sale points within the NFT cooldown.
SALE_POINTS_SELLER=10
SALE_POINTS_BUYER=5
SALE_POINTS_PAIR_COOLDOWN_SEC=604800
SALE_POINTS_NFT_COOLDOWN_SEC=86400
SALE_POINTS_MAX_PER_DAY=5
POINTS_SETTLE_MS=60000
BONUS_MAX_TX_AGE_SEC=86400
BONUS_COMMITMENT=confirmed
GC_DECIMALS=6

# --- sessions ---
SESSION_TTL_SEC=3600
NONCE_TTL_SEC=300
# PG_POOL_MAX=10            # lower (e.g. 5) if the DB plan has few connections

# NOTE: there is no API "cluster" variable. The cluster is implied by RPC_URL.
# The web app's cluster is NEXT_PUBLIC_SOLANA_NETWORK=devnet (set in Vercel, not here).
