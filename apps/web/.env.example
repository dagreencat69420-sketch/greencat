# Production / real app: pump.fun $GC on mainnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Mainnet program id (SDK default is the Devnet id 8Sy7mqZjHg9U9JW2qe1fEAfooyUrnDkz1XdqFB3ywvPE):
NEXT_PUBLIC_GREENCAT_PROGRAM_ID=2pwrnxCswbq9cjgfRWQAMJUp6n1MRALpURLBjbmFURdc
NEXT_PUBLIC_GC_MINT=G2b4ZNxLjgTnVtPbuHpK9WXpccFCedoLYQ5uxvdEpump

# Optional: use a paid RPC (Helius/etc.) if public mainnet RPC rate-limits
# NEXT_PUBLIC_RPC_URL=https://your-helius-or-triton-url

# Global backend (apps/api). Set to enable the server-authoritative global Points board,
# Sign-In-With-Solana and indexer-backed marketplace browse. Leave unset → localStorage fallback.
# NEXT_PUBLIC_API_URL=http://localhost:8787

# NFT art (art-v1, WebP). Image URL = {NEXT_PUBLIC_NFT_IMAGE_BASE}{tokenId}.webp. Default "/nft/images/" serves the
# locally rendered WebPs via src/app/nft/images/[file]/route.ts (reads ART_IMAGES_DIR or ../../art/out/images-webp).
# After the IPFS upload (art/tools/upload_nftstorage.mjs prints the CID):
# NEXT_PUBLIC_NFT_IMAGE_BASE=ipfs://<IMAGES_CID>/
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/    # or a dedicated/paid gateway for reliability
# ART_IMAGES_DIR=/workspace/greencat-app/art/out/images-webp
