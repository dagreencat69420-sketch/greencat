{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../apps/api/node_modules/@types"],
    "paths": { "@greencat/sdk": ["../packages/sdk/src/index.ts"] }
  },
  "include": ["*.ts", "lib/*.ts"]
}
